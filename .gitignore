# --- Secrets: never commit these, under any circumstance ---
# Credentials are supplied via Docker Compose file-based secrets
# (mounted to /run/secrets/), never baked into the image or repo.
.env
.env.*
!.env.example
*secret*
/secrets/
*.pem
*.key
*.p12
*.pfx
*credentials*
*.token

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Logs / local state ---
*.log
.cache/
